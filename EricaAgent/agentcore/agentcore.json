{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "EricaAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "EricaAgent"
  },
  "runtimes": [
    {
      "name": "EricaAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/EricaAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "LANGSMITH_TRACING",
          "value": "true"
        },
        {
          "name": "LANGSMITH_PROJECT",
          "value": "erica-agentcore-session"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}